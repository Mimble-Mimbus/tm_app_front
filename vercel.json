{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install sqlite3 --ignore-scripts && npm install",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}